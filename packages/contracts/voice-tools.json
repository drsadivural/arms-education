      "parameters": {
        "type": "object",
        "properties": {
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "prepare_reservation",
      "description": "枠を特定し確認カードと短期action tokenを準備。予約変更なし。",
