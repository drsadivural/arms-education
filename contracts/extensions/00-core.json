              },
              "notifications_enabled": {
                "type": "boolean"
              },
              "row_version": {
                "type": "integer"
              }
            },
            "required": [
              "theme",
              "notifications_enabled",
              "row_version"
            ],
            "additionalProperties": false
          },
          "student": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "employee_number": {
                "type": "string"
              },
              "classroom_id": {
                "type": "string",
                "format": "uuid"
              },
              "classroom_name": {
                "type": "string"
              },
              "teacher_id": {
