            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false
          },
          "row_version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "classroom_id",
          "teacher_id",
          "unit_id",
          "title",
          "starts_at",
          "ends_at",
          "capacity",
          "booking_closes_at",
          "meeting_url",
          "has_meeting_url",
          "cancel_before_seconds",
          "teacher_name",
          "classroom_name",
          "remaining",
          "state",
          "row_version"
        ],
        "additionalProperties": false
      },
