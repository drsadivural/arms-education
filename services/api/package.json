{
  "name": "@arms/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../../apps/web/dist',{recursive:true})\" && wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@arms/contracts": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "aws4fetch": "1.0.20",
    "encoding-japanese": "2.4.0",
    "hono": "4.13.12",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.12",
    "pdfjs-dist": "5.4.296",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.146.0"
  }
}
