          }
        },
        "required": [
          "reservation_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "commit_cancellation",
      "description": "明示確認後、本人tokenを検証して取消。",
      "parameters": {
        "type": "object",
        "properties": {
          "action_token": {
            "type": "string",
            "minLength": 32
          }
        },
        "required": [
          "action_token"
        ],
        "additionalProperties": false
      }
    }
