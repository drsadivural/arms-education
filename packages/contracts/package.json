{
  "name": "@arms/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json",
    "./voice-tools.json": "./voice-tools.json"
