          },
          "employee_number": {
            "type": "string"
          },
          "slot_title": {
            "type": "string"
          },
          "teacher_id": {
            "type": "string",
            "format": "uuid"
          },
          "teacher_name": {
            "type": "string"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_name": {
            "type": "string"
          },
          "meeting_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "承認済みの本人・担当講師・管理者にのみ返す。"
          },
          "cancel_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_type": {
                  "type": "string"
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "actor_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "event_type",
                "status",
                "reason",
                "actor_name",
                "created_at"
              ],
              "additionalProperties": false
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slot_id",
          "student_id",
          "status",
          "starts_at",
          "ends_at",
          "expires_at",
          "row_version",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "selected_role": {
            "type": "string",
            "enum": [
              "admin",
              "teacher",
              "student"
            ]
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "description": "同じ利用区分で複数組織に所属する場合のみ指定（ORG_SELECTION_REQUIRED応答のdetails.organizationsから選択）。"
          }
        },
        "required": [
          "email",
          "password",
          "selected_role"
        ],
        "additionalProperties": false
      },
      "PasswordSetInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "メールリンクの #token= の値（一回限り）。"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "英字と数字を両方含む10文字以上。"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "additionalProperties": false
      },
      "TokenGrantInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device_label": {
            "type": "string",
            "maxLength": 100,
            "description": "端末の表示名（任意、セッション管理用）。"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "TokenRefreshInput": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refresh_token"
        ],
        "additionalProperties": false
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Authorization: Bearer に使う不透明トークン。"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "description": "アクセストークンの残り秒数。"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "セッションの最長期限（再ログインが必要になる時刻）。"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "refresh_expires_at",
          "user_id"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TokenPair"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "checked_at"
        ],
        "additionalProperties": false
      }
    }
  }
}
