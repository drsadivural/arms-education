{
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "post_auth_login",
        "summary": "Webログイン",
        "description": "許可ロール: 公開。メール/パスワードをAuthで検証し、選択した利用区分とDB membershipを照合してHttpOnlyセッションを発行する。管理者でMFA未完了の場合は mfa_required=true を返し、MFA完了まで業務APIを拒否する。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "operationId": "post_auth_password_reset",
        "summary": "パスワード再設定メール送信",
        "description": "許可ロール: 公開。登録済みで有効な利用者には1時間有効の再設定リンクをメール送信する。列挙防止のため、未登録・停止中のアドレスでも同じ応答を返す。メール送信サービス未設定は503 NOT_CONFIGURED。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受付",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/mfa/enroll": {
      "post": {
        "operationId": "post_auth_mfa_enroll",
        "summary": "管理者MFA(TOTP)登録開始",
        "description": "許可ロール: admin（パスワード認証済みセッション）。TOTPのQRコード(SVG data URI)と登録用URIを返す。",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrollResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "operationId": "post_auth_mfa_verify",
        "summary": "管理者MFAコード検証",
        "description": "許可ロール: admin（パスワード認証済みセッション）。成功するとセッションがaal2になり業務APIを利用できる。",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfoResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "get_me",
        "summary": "本人とロール",
        "description": "許可ロール: 全員。iOSは X-ARMS-Selected-Role ヘッダーで選択した利用区分を送り、DB membershipと一致しなければ403 ROLE_MISMATCHを返す。",
        "tags": [
          "me"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-ARMS-Selected-Role",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "admin",
                "teacher",
                "student"
              ]
            }
          },
          {
            "name": "X-ARMS-Org",
            "in": "header",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "複数組織に所属するBearer利用者のみ。DB membershipで検証する。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/password": {
      "post": {
        "operationId": "post_auth_password",
        "summary": "招待・再設定リンクからのパスワード設定",
        "description": "許可ロール: 公開（招待・パスワード再設定メールのリンクに含まれる一回限りのトークンで認可。有効期限: 招待24時間・再設定1時間）。組織メンバーシップが必要。設定後はトークンを無効化し、パスワード再設定の場合はほかの端末のセッションを解除する。受講者はiOS、管理者・講師はWebでログインするよう案内する。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/tokens": {
      "post": {
        "operationId": "post_auth_tokens",
        "summary": "iOSログイン（トークン発行）",
        "description": "許可ロール: 公開（メールアドレス・パスワードで認証）。iOSアプリ用。いずれかの組織に有効なメンバーシップが必要。不透明なアクセストークン（1時間）とリフレッシュトークン（ローテーション、最終利用から30日・ログインから最長90日）を返す。ロールは発行後に GET /me でサーバーが判定する。連続10回の失敗で15分ログインを制限（429）。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenGrantInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/tokens/refresh": {
      "post": {
        "operationId": "post_auth_tokens_refresh",
        "summary": "iOSトークン更新",
        "description": "許可ロール: 公開（リフレッシュトークンで認可）。新しいアクセストークンとリフレッシュトークンを返し、古いリフレッシュトークンは無効になる。無効化済みのリフレッシュトークンが再提示された場合は盗用とみなしてセッションを失効させる（401 SESSION_EXPIRED）。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRefreshInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/tokens/revoke": {
      "post": {
        "operationId": "post_auth_tokens_revoke",
        "summary": "iOSログアウト（トークン失効）",
        "description": "許可ロール: 公開（リフレッシュトークンで認可）。そのセッションを失効させる。未知・失効済みのトークンでも同じ成功応答（冪等）。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRefreshInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PasswordResetInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "MfaVerifyInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "MfaEnrollResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string"
              },
              "qr_code": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "factor_id",
              "qr_code",
              "uri"
            ],
            "additionalProperties": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "User": {
