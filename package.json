{
  "name": "arms",
  "private": true,
  "description": "ARMS 新入社員研修システム — Web管理アプリ・API・iOSアプリ",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "gen:contracts": "pnpm --filter @arms/contracts gen",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm --filter @arms/web build && pnpm --filter @arms/api build",
    "db:migrate": "node scripts/db/migrate.mjs",
    "dev:infra": "docker compose -f infra/local/compose.yaml up -d",
    "dev:api": "pnpm --filter @arms/api dev",
    "dev:web": "pnpm --filter @arms/web dev",
    "check:package": "node scripts/validate.cjs && node scripts/test-db.cjs",
    "secrets:scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
