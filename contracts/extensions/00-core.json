            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "row_version": {
            "type": "integer"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "student_name": {
            "type": "string"
          },
          "employee_number": {
            "type": "string"
          },
          "slot_title": {
            "type": "string"
          },
          "teacher_id": {
            "type": "string",
            "format": "uuid"
          },
          "teacher_name": {
            "type": "string"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_name": {
            "type": "string"
          },
          "meeting_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "承認済みの本人・担当講師・管理者にのみ返す。"
          },
          "cancel_deadline": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_type": {
                  "type": "string"
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "actor_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "event_type",
                "status",
                "reason",
                "actor_name",
                "created_at"
              ],
              "additionalProperties": false
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slot_id",
          "student_id",
          "status",
          "starts_at",
          "ends_at",
          "expires_at",
          "row_version",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "selected_role": {
            "type": "string",
            "enum": [
              "admin",
              "teacher",
              "student"
            ]
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "description": "同じ利用区分で複数組織に所属する場合のみ指定（ORG_SELECTION_REQUIRED応答のdetails.organizationsから選択）。"
          }
        },
        "required": [
          "email",
          "password",
          "selected_role"
        ],
        "additionalProperties": false
      },
      "PasswordSetInput": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4096
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "英字と数字を両方含む10文字以上。"
          }
        },
        "required": [
          "access_token",
          "password"
        ],
        "additionalProperties": false
      }
    }
  }
}
