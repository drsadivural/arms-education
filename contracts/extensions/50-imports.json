  "components": {
    "schemas": {
      "ImportJob": {
        "type": "object",
        "description": "移行ジョブ。valid_rows = total_rows - error_rows（新規＋更新＋変更なし）。",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "uploaded",
              "validated",
              "committing",
              "completed",
              "failed",
              "rolled_back"
            ]
          },
          "entity": {
            "type": "string",
            "enum": [
              "teachers",
              "classrooms",
              "students",
              "progress"
            ]
          },
          "source_system": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf-8",
              "utf-8-bom",
              "cp932"
            ]
          },
          "detected_encoding": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "utf-8",
              "utf-8-bom",
              "cp932",
              "ascii",
              null
            ]
          },
          "encoding_mismatch": {
            "type": "boolean",
