{
  "paths": {
    "/lesson-slots/{id}": {
      "get": {
        "operationId": "get_lesson_slots_id",
        "summary": "授業枠詳細",
        "description": "許可ロール: admin/teacher/student。受講者は所属クラスの枠のみ、講師は担当クラスの枠のみ（範囲外は404）。remainingは取得時にlive pending＋approvedをDB集計。meeting_urlは管理者・枠の担当講師・承認済み予約の本人にのみ値を返す。ETagはrow_version。",
        "tags": [
          "lesson-slots"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonSlotResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/lesson-slots/{id}/cancel": {
      "post": {
        "operationId": "post__lesson-slots_id_cancel",
        "summary": "授業枠を理由付き取消",
        "description": "許可ロール: admin/teacher（枠の担当講師のみ）。理由1〜1,000文字必須、expected_versionは枠のrow_version。同一transactionで枠をcancelledにし、承認待ち・承認済みの予約をすべて取消済み（理由付き）へ遷移させ、監査と受講者への通知outboxを記録する。dataに {id, state, row_version, cancelled_reservations}。",
        "tags": [
          "lesson-slots"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "cookie認証の場合必須。Bearer専用iOSには不要。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeactivateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/lesson-slots/{id}/attendance": {
      "get": {
        "operationId": "get_lesson_slots_id_attendance",
        "summary": "担当授業の出欠名簿",
        "description": "許可ロール: admin/teacher（枠の担当講師のみ）。名簿は当該枠で承認済みの予約を持つ受講者＋既に出欠記録がある受講者。予約状態と現在の出欠を返す。",
        "tags": [
          "lesson-slots"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceRosterResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/reservations": {
      "get": {
        "operationId": "get_reservations",
        "summary": "予約一覧",
        "description": "許可ロール: admin/teacher/student。受講者は本人、講師は担当授業枠の予約、管理者は組織内全件。status はカンマ区切り（pending,approved,rejected,cancelled,expired,removed）。removed は status で明示した場合のみ返す。保持期限を過ぎた pending は取得時に expired として扱う。from/to/month は組織タイムゾーンの日付で授業開始日時を絞り込む。idempotency_key は呼び出し本人の申請を検索する。",
        "tags": [
          "reservations"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "受講者氏名・社員番号の部分一致"
          },
          {
            "name": "slot_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "classroom_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "teacher_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "student_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          {
            "name": "idempotency_key",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "starts_at",
                "-starts_at",
                "-created_at"
              ],
              "default": "starts_at"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Reservation"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "checked_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "operationId": "get_notifications",
        "summary": "本人通知",
        "description": "許可ロール: 全員。本人宛のアプリ内通知を新しい順に返す。status=unread で未読のみ、status=read で既読のみ。",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "unread",
                "read"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/notifications/read-all": {
      "post": {
        "operationId": "post_notifications_read_all",
        "summary": "すべて既読",
        "description": "許可ロール: 全員。本人宛の未読通知をすべて既読にする。dataに {updated}。",
        "tags": [
          "notifications"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "cookie認証の場合必須。Bearer専用iOSには不要。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/devices/{token_hash}": {
      "delete": {
        "operationId": "delete_devices_token_hash",
        "summary": "APNs登録解除",
        "description": "許可ロール: teacher/student。ログアウト時に本人の端末登録を削除する。token_hash は登録時の端末トークン（16進小文字）のSHA-256（16進小文字64桁）。端末登録はバージョン管理対象外のため If-Match は不要。未登録でも成功を返す（冪等）。",
        "tags": [
          "devices"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "token_hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "cookie認証の場合必須。Bearer専用iOSには不要。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SlotInput": {
        "type": "object",
        "description": "授業枠の追加・編集共通フォーム。PATCHは全項目置換（unit_id・meeting_url を省略するとnull）。cancel_before_seconds を省略すると、作成時は組織設定（なければ既定値）、編集時は現在値。state は open/closed（取消は /lesson-slots/{id}/cancel）。",
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "teacher_id": {
            "type": "string",
            "format": "uuid"
          },
          "unit_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "booking_closes_at": {
            "type": "string",
            "format": "date-time"
          },
          "meeting_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "cancel_before_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2592000
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "required": [
          "classroom_id",
          "teacher_id",
          "title",
          "starts_at",
          "ends_at",
          "capacity",
          "booking_closes_at"
        ],
        "additionalProperties": false
      },
      "AttendanceRosterItem": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_name": {
            "type": "string"
          },
          "employee_number": {
            "type": "string"
          },
          "reservation_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "reservation_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "approved",
              "rejected",
              "cancelled",
              "expired",
              "removed",
              null
            ]
          },
          "attendance_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "present",
              "absent",
              "late",
              "excused",
              null
            ]
          },
          "note": {
            "type": "string"
          },
          "recorded_by_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "recorded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "student_id",
          "student_name",
          "employee_number",
          "reservation_id",
          "reservation_status",
          "attendance_state",
          "note",
          "recorded_by_name",
          "recorded_at"
        ],
        "additionalProperties": false
      },
      "AttendanceRoster": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "slot_title": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "cancelled"
            ]
          },
          "editable": {
            "type": "boolean",
            "description": "授業開始30分前以降かつ取消されていない場合true"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttendanceRosterItem"
            }
          }
        },
        "required": [
          "slot_id",
          "slot_title",
          "starts_at",
          "ends_at",
          "state",
          "editable",
          "items"
        ],
        "additionalProperties": false
      },
      "AttendanceRosterResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AttendanceRoster"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "checked_at"
        ],
        "additionalProperties": false
      }
    }
  }
}
