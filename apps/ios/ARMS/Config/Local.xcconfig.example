// Copy to Local.xcconfig (git-ignored) and fill in the customer's values.
// Only public values belong here: the Supabase publishable key is public by design;
// never put the Supabase secret/service key, OpenAI key or APNs .p8 key into the app.

API_BASE_URL = https:/$()/arms-api.example.com
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
TERMS_URL = https:/$()/example.com/terms
PRIVACY_POLICY_URL = https:/$()/example.com/privacy

BUNDLE_ID = jp.co.customer.arms
DEVELOPMENT_TEAM = ABCDE12345
