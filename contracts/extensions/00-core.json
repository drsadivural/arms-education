{
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "post_auth_login",
        "summary": "Webログイン",
        "description": "許可ロール: 公開。メール/パスワードをAuthで検証し、選択した利用区分とDB membershipを照合してHttpOnlyセッションを発行する。管理者でMFA未完了の場合は mfa_required=true を返し、MFA完了まで業務APIを拒否する。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "operationId": "post_auth_password_reset",
        "summary": "パスワード再設定メール送信",
        "description": "許可ロール: 公開。登録有無にかかわらず同じ応答を返す（アカウント列挙防止）。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受付",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/mfa/enroll": {
      "post": {
        "operationId": "post_auth_mfa_enroll",
        "summary": "管理者MFA(TOTP)登録開始",
        "description": "許可ロール: admin（パスワード認証済みセッション）。TOTPのQRコード(SVG data URI)と登録用URIを返す。",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrollResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "operationId": "post_auth_mfa_verify",
        "summary": "管理者MFAコード検証",
        "description": "許可ロール: admin（パスワード認証済みセッション）。成功するとセッションがaal2になり業務APIを利用できる。",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfoResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "get_me",
        "summary": "本人とロール",
        "description": "許可ロール: 全員。iOSは X-ARMS-Selected-Role ヘッダーで選択した利用区分を送り、DB membershipと一致しなければ403 ROLE_MISMATCHを返す。",
        "tags": [
          "me"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-ARMS-Selected-Role",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "admin",
                "teacher",
                "student"
              ]
            }
          },
          {
            "name": "X-ARMS-Org",
            "in": "header",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "複数組織に所属するBearer利用者のみ。DB membershipで検証する。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/password": {
      "post": {
        "operationId": "post_auth_password",
        "summary": "招待・再設定リンクからのパスワード設定",
        "description": "許可ロール: 公開（メールリンクの短期アクセストークンをAuthの公開鍵で検証）。組織メンバーシップが必要。受講者はiOS、管理者・講師はWebでログインするよう案内する。",
        "tags": [
          "auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordSetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PasswordResetInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "MfaVerifyInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "MfaEnrollResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "factor_id": {
                "type": "string"
              },
              "qr_code": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "factor_id",
              "qr_code",
              "uri"
            ],
            "additionalProperties": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "teacher",
              "student"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "invitation_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "auth_created",
              "profile_created",
              "sent",
              "failed",
              null
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "role",
          "active"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "teacher",
              "student"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "timezone"
            ],
            "additionalProperties": false
          },
          "preferences": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "system"
                ]
              },
              "notifications_enabled": {
                "type": "boolean"
              },
              "row_version": {
                "type": "integer"
              }
            },
            "required": [
              "theme",
              "notifications_enabled",
              "row_version"
            ],
            "additionalProperties": false
          },
          "student": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "employee_number": {
                "type": "string"
              },
              "classroom_id": {
                "type": "string",
                "format": "uuid"
              },
              "classroom_name": {
                "type": "string"
              },
              "teacher_id": {
                "type": "string",
                "format": "uuid"
              },
              "teacher_name": {
                "type": "string"
              },
              "department_name": {
                "type": "string"
              }
            },
            "required": [
              "employee_number",
              "classroom_id",
              "classroom_name",
              "teacher_id",
              "teacher_name",
              "department_name"
            ],
            "additionalProperties": false
          },
          "mfa": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "required",
              "verified"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "role",
          "active",
          "organization",
          "preferences",
          "student",
          "mfa"
        ],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Me"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrf_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "organization_name": {
            "type": "string"
          },
          "mfa_required": {
            "type": "boolean"
          },
          "mfa_enrolled": {
            "type": "boolean"
          }
        },
        "required": [
          "user",
          "csrf_token",
          "expires_at",
          "organization_name",
          "mfa_required",
          "mfa_enrolled"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message_ja": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "field_errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message_ja",
          "request_id"
        ],
        "additionalProperties": false
      },
      "LessonSlot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "teacher_id": {
            "type": "string",
            "format": "uuid"
          },
          "unit_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "booking_closes_at": {
            "type": "string",
            "format": "date-time"
          },
          "meeting_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "承認済み本人・担当講師・管理者にのみ値を返す。それ以外はnull。"
          },
          "has_meeting_url": {
            "type": "boolean"
          },
          "cancel_before_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "teacher_name": {
            "type": "string"
          },
          "classroom_name": {
            "type": "string"
          },
          "remaining": {
            "type": "integer"
          },
          "pending_count": {
            "type": "integer"
          },
          "approved_count": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "cancelled"
            ]
          },
          "my_reservation": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected",
                  "cancelled",
                  "expired",
                  "removed"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": false
          },
          "row_version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "classroom_id",
          "teacher_id",
          "unit_id",
          "title",
          "starts_at",
          "ends_at",
          "capacity",
          "booking_closes_at",
          "meeting_url",
          "has_meeting_url",
          "cancel_before_seconds",
          "teacher_name",
          "classroom_name",
          "remaining",
          "state",
          "row_version"
        ],
        "additionalProperties": false
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
